# Copy this file to .env in the same folder (apps/desktop/.env) and fill in
# your own Supabase project's values — Settings -> API in the Supabase dashboard.
#
# VITE_SUPABASE_ANON_KEY is safe to expose in the frontend bundle; it is the
# "public" key. Row Level Security (see 0001_init_schema.sql) is what
# actually protects your data, not keeping this key secret.
#
# NEVER put a service_role key in this file or anywhere in apps/desktop --
# that key bypasses RLS entirely and must only ever be used server-side
# (e.g. in a Supabase Edge Function), never shipped to a browser.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
